# Copiar a .env y completar. El .env NO se sube al repo (esta en .gitignore).
# docker compose lo lee con env_file: los valores van SIN comillas y sin
# espacios alrededor del =. Si la password tiene un # , el # y lo que sigue se
# toma como comentario: cambiala o vas a loguearte con media clave.

# --- API propia (la cola de altas) -----------------------------------------
# API_KEY tiene que ser IDENTICA a BOT_API_KEY en api/config.local.php.
#
# OJO: es altas_cola.php, NO el viejo cola_panel.php: ese consulta la tabla
# `jugadores`, que la migracion 07 borro, y responde 500. Y la API vive bajo
# /gp-api/ (el VPS), no bajo /api/: esa ruta era del hosting viejo.
API_URL=https://ganamoscrm.online/gp-api/altas_cola.php
API_KEY=una-clave-larga-y-random

# --- Panel de agentes -------------------------------------------------------
# agents.ganamos7.com y agents.ganamosonline.com son EL MISMO panel (misma
# cuenta, mismos jugadores -- PROBADO a mano el 16/09/2026: mismo ID de
# agente y mismo saldo por las dos puertas). La diferencia es la puerta:
# ganamosonline esta detras de CLOUDFLARE (Bot Fight Mode: 403 a un curl
# pelado, y challenges intermitentes que trabaron altas y depositos);
# ganamos7 es nginx pelado. Decision del dueño (16/09/2026): se usa
# ganamos7 para no cruzar mas el WAF.
#
# Este bloque ya estuvo mal DOS veces porque los dos dominios responden 200
# a un navegador -- si vas a cambiarlo, primero medi (headers + login a
# mano), y mira si las altas estan saliendo. Volver atras es cambiar estas
# dos lineas y recrear el contenedor.
PANEL_URL=https://agents.ganamos7.com/user/create-player

# La barra final NO sobra: el login del panel vive en la RAIZ, la URL nunca
# dice "login". Si apuntas a /login, el bot carga una pagina sin campo de
# password y muere con "No encontre los campos del login".
LOGIN_URL=https://agents.ganamos7.com/

# Credenciales del agente. En el contenedor no hay forma de destrabar un login
# a mano: si esto falla (captcha/2FA), se entra con la sesion pregrabada que se
# deja en datos/estado_sesion.json.
PANEL_USER=tu-usuario
PANEL_PASS=tu-password

# Cada cuantos segundos se consulta la cola.
POLL_SEGUNDOS=30

# --- Altas por API (fast-path) ----------------------------------------------
# Prendido por defecto: el lote entero sale por la API del panel (~1s por alta)
# con una plantilla aprendida del primer alta por formulario, que se persiste
# en datos/alta_endpoint.json. ALTA_FAST=0 lo apaga y todo vuelve al formulario.
# ALTA_FAST=1

# --- Cargas de saldo (fichas -> juego) --------------------------------------
# DRY_RUN: completa el formulario de deposito y NO lo envia. Es el default.
# LIVE:    deposita plata de verdad en la cuenta del jugador.
# Mira una pasada en DRY_RUN antes de cambiarlo: un selector desactualizado en
# LIVE no falla con una excepcion, deposita en la fila equivocada.
FICHAS_MODE=DRY_RUN

# Se deriva sola de API_URL (misma carpeta). Solo si esta en otro lado:
# ACCIONES_URL=https://ganamoscrm.online/gp-api/acciones_cola.php
